<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      diag only needs ACCESS_FINE_LOCATION below API 31 for scanning (core/ble's manifest caps
      it at maxSdk 30). full also runs its own Routes-API guidance loop, which needs it
      unconditionally - this entry overrides the merged maxSdk-capped one for the same name.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="replace" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Maps tiles and the Routes API call - the only network access this app needs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 16+ "Live Update" promotion for the navigation notification (Deliverable 5). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Enhanced set: requested in onboarding, never blocks reaching the app. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application>
        <!--
          Read by both the Maps SDK itself and RoutesApiRepository (core/data), so one key
          entered in secrets.properties covers both. MAPS_API_KEY defaults to an empty string
          (app/build.gradle.kts) so a keyless clone still builds and installs - the nav screen
          detects the empty key and explains itself rather than crashing. See docs/SETUP.md.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!--
          ClusterService also runs the guidance loop, so it touches both connectedDevice
          (the BLE link) and location (position tracking while navigating).
        -->
        <service
            android:name=".ClusterService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location"
            tools:replace="android:foregroundServiceType" />

        <!--
          Settings-granted roles, no runtime dialog. Registered so they are visible and
          grantable from onboarding; the frame-sending logic is future work.
        -->
        <!--
          Exports the ride log from the hidden debug menu. diag's Log tab shares its whole
          log via Intent.EXTRA_TEXT, which an hour of ride logging would blow past the Binder
          transaction limit - a content:// URI has no such limit.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="dev.jay.betterconnect.core.ble.CallScreeningRoleService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name="dev.jay.betterconnect.core.ble.ClusterNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
